{
  "name": "zhu-chen-homepage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Terminal-inspired academic homepage built with Astro, TypeScript and xterm.js.",
  "engines": {
    "node": "^22.22.2",
    "npm": "^12.1.0"
  },
  "packageManager": "npm@12.1.0",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:install": "playwright install chromium",
    "verify": "npm run format:check && npm run build && npm test"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
