---
import '@xterm/xterm/css/xterm.css';
---

<section class="terminal-panel" aria-labelledby="terminal-title">
  <h2 id="terminal-title">~/welcome</h2>
  <terminal-preview>
    <div class="terminal-screen" data-terminal-screen hidden></div>
    <p data-terminal-fallback>欢迎来到我的主页。</p>
  </terminal-preview>
</section>

<script>
  import '../scripts/terminal-preview';
</script>

<style>
  .terminal-panel {
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  h2 {
    margin: 0;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 400;
  }

  terminal-preview {
    display: block;
    padding: 1rem;
  }

  .terminal-screen {
    height: 8rem;
    min-width: 0;
  }

  [data-terminal-fallback] {
    margin: 0;
  }
</style>
