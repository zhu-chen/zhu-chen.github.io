---
import '@xterm/xterm/css/xterm.css';
---

<section class="terminal-panel tui-panel" aria-labelledby="terminal-title">
  <div class="panel-heading">
    <h2 id="terminal-title" class="panel-path">
      ~/terminal
    </h2>
    <span class="terminal-mode">交互终端</span>
  </div>
  <homepage-terminal>
    <div class="terminal-surface" data-terminal-surface>
      <div class="terminal-screen" data-terminal-screen hidden></div>
      <p data-terminal-fallback>欢迎来到我的主页。</p>
      <form
        id="terminal-command-form"
        class="command-line"
        aria-label="运行主页命令"
        data-terminal-controls
        hidden
      >
        <label class="sr-only" for="terminal-command">
          命令
        </label>
        <span class="prompt" aria-hidden="true">
          <span data-terminal-path>~</span> ${' '}
        </span>
        <span class="command-editor">
          <input
            id="terminal-command"
            name="command"
            type="text"
            maxlength="256"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            enterkeyhint="send"
            aria-describedby="terminal-hint"
            placeholder=" "
          />
          <span class="idle-cursor" aria-hidden="true"></span>
        </span>
      </form>
    </div>
    <div class="terminal-toolbar" data-terminal-controls hidden>
      <div class="command-actions" aria-label="常用命令">
        <button type="submit" form="terminal-command-form" aria-label="执行">
          <span aria-hidden="true">[ ↵ 执行 ]</span>
        </button>
        <button type="button" data-command="help" aria-label="help">
          <span aria-hidden="true">[ help 帮助 ]</span>
        </button>
        <button type="button" data-command="ls" aria-label="ls">
          <span aria-hidden="true">[ ls 目录 ]</span>
        </button>
        <button type="button" data-command="cd ~" aria-label="回到根目录">
          <span aria-hidden="true">[ cd ~ 返回 ]</span>
        </button>
        <button type="button" data-command="clear" aria-label="清屏">
          <span aria-hidden="true">[ clear 清屏 ]</span>
        </button>
      </div>
      <p id="terminal-hint">Enter 执行 · ↑ ↓ 历史 · 点击提示符后即可输入</p>
    </div>
  </homepage-terminal>
</section>

<script>
  import '../scripts/terminal';
</script>

<style>
  h2 {
    margin: 0;
    font-size: inherit;
    font-weight: 400;
    scroll-margin-top: 1.5rem;
  }
  .terminal-mode {
    color: var(--muted);
    font-size: 0.75rem;
  }
  homepage-terminal {
    display: block;
    padding: 1rem 1.25rem 0.75rem;
  }
  .terminal-surface {
    position: relative;
    overflow: hidden;
    min-width: 0;
  }
  .terminal-screen {
    height: 18rem;
    min-width: 0;
  }
  [data-terminal-fallback] {
    margin: 0 0 0.5rem;
  }
  .command-line {
    position: absolute;
    top: var(--prompt-top, 0px);
    left: 0;
    display: flex;
    align-items: center;
    width: var(--terminal-width, 100%);
    height: var(--terminal-row-height, 1.5rem);
    margin: 0;
    background: var(--background);
    font-size: 1rem;
    line-height: 1.5;
    cursor: text;
  }
  .command-line:focus-within .prompt {
    color: var(--foreground);
  }
  .prompt {
    flex-shrink: 0;
    color: var(--accent);
    white-space: pre;
  }
  .command-editor {
    position: relative;
    display: flex;
    flex: 1;
    align-items: center;
    height: 100%;
    min-width: 0;
  }
  input {
    display: block;
    width: 100%;
    min-width: 0;
    height: 100%;
    border: 0;
    border-radius: 0;
    outline: none;
    padding: 0;
    background: transparent;
    color: var(--foreground);
    caret-color: var(--accent);
    font: inherit;
    line-height: inherit;
  }
  .idle-cursor {
    display: none;
    position: absolute;
    left: 0;
    width: 1ch;
    height: 1.1em;
    border: 1px solid var(--accent);
    pointer-events: none;
  }
  input:placeholder-shown {
    caret-color: transparent;
  }
  input:placeholder-shown + .idle-cursor {
    display: block;
  }
  input:focus:placeholder-shown + .idle-cursor {
    background: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    input:focus:placeholder-shown + .idle-cursor {
      animation: cursor-blink 1.2s step-end infinite;
    }
  }
  @keyframes cursor-blink {
    50% {
      opacity: 0;
    }
  }
  .terminal-toolbar {
    margin-top: 1rem;
    border-top: 1px dashed var(--border);
    padding-top: 0.25rem;
  }
  .command-actions {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1rem;
  }
  button {
    min-height: 2.75rem;
    border: 0;
    border-radius: 0;
    padding: 0;
    background: transparent;
    color: var(--accent);
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }
  button:hover,
  button:focus-visible {
    color: var(--background);
    background: var(--accent);
  }
  #terminal-hint {
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: 0.75rem;
  }
  @media (max-width: 40rem) {
    homepage-terminal {
      padding: 0.75rem 0.75rem 0.5rem;
    }
    .command-actions {
      column-gap: 0.875rem;
    }
  }
</style>
